{
  "name": "@curb/auth",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": [
        "./dist/*/index.d.ts",
        "./dist/*.d.ts"
      ],
      "default": [
        "./src/*/index.ts",
        "./src/*.ts"
      ]
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsdown"
  },
  "devDependencies": {
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "better-auth": "catalog:",
    "@better-auth/expo": "^1.3.13",
    "@polar-sh/better-auth": "catalog:",
    "@polar-sh/sdk": "^0.34.16",
    "dotenv": "catalog:",
    "zod": "catalog:",
    "@curb/db": "workspace:*"
  }
}
