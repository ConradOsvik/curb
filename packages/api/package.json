{
  "name": "@curb/api",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": [
        "./dist/*/index.d.ts",
        "./dist/*.d.ts"
      ],
      "default": [
        "./src/*/index.ts",
        "./src/*.ts"
      ]
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsdown"
  },
  "devDependencies": {
    "tsdown": "catalog:"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@trpc/server": "catalog:",
    "@trpc/client": "catalog:",
    "dotenv": "catalog:",
    "zod": "catalog:",
    "@curb/auth": "workspace:*",
    "@curb/db": "workspace:*"
  }
}
