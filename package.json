{
  "name": "curb",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "db:push": "turbo -F @curb/db db:push",
    "db:generate": "turbo -F @curb/db db:generate",
    "db:migrate": "turbo -F @curb/db db:migrate",
    "db:studio": "turbo -F @curb/db db:studio",
    "auth:generate": "turbo -F @curb/auth auth:generate",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@curb/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@curb/config": "workspace:*",
    "oxfmt": "latest",
    "oxlint": "latest",
    "turbo": "^2.6.3",
    "typescript": "catalog:",
    "ultracite": "7.1.1"
  },
  "packageManager": "bun@1.3.9",
  "catalog": {
    "@better-auth/expo": "1.4.9",
    "@better-auth/passkey": "1.4.9",
    "better-auth": "1.4.9",
    "dotenv": "^17.2.2",
    "typescript": "^5",
    "zod": "^4.1.13"
  }
}
