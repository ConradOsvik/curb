{
  "name": "curb",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "biome check --write .",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "db:push": "turbo -F @curb/db db:push",
    "db:studio": "turbo -F @curb/db db:studio",
    "db:generate": "turbo -F @curb/db db:generate",
    "db:migrate": "turbo -F @curb/db db:migrate",
    "db:local": "turbo -F @curb/db db:local"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:",
    "@curb/env": "workspace:*"
  },
  "devDependencies": {
    "turbo": "^2.6.3",
    "@biomejs/biome": "2.3.10",
    "ultracite": "6.5.0",
    "typescript": "catalog:",
    "@types/node": "^22.13.11",
    "@curb/config": "workspace:*"
  },
  "packageManager": "pnpm@10.20.0"
}
