# Database (use file: for local SQLite, libsql:// for Turso)
DATABASE_URL=http://localhost:8080
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_TOKEN=your-token

# S3 Storage (Minio in dev, R2 in prod)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=curb
S3_PUBLIC_URL=http://localhost:9000/curb

# Auth
BETTER_AUTH_SECRET=some-random-secret
BETTER_AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=re_your_api_key
# EMAIL_FROM=Curb <noreply@yourdomain.com>

# AI (receipt scanning)
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-key
